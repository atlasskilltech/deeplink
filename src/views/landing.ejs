<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>

  <!-- Smart App Banners (Section 5.3) -->
  <meta name="google-play-app" content="app-id=<%= androidPackage %>" />
  <meta name="apple-itunes-app"
        content="app-id=<%= iosAppStoreId %>, app-argument=<%= deepLinkUrl %>" />

  <style>
    :root {
      --bg: #0f172a;
      --card: #1e293b;
      --fg: #f8fafc;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --accent-2: #22c55e;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: radial-gradient(1200px 600px at 50% -10%, #1e3a5f 0%, var(--bg) 60%);
      color: var(--fg);
      padding: 24px;
    }
    .card {
      width: 100%;
      max-width: 440px;
      background: var(--card);
      border: 1px solid rgba(148, 163, 184, 0.15);
      border-radius: 20px;
      padding: 40px 32px;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    }
    .logo {
      width: 72px; height: 72px;
      margin: 0 auto 20px;
      border-radius: 18px;
      background: linear-gradient(135deg, var(--accent), #6366f1);
      display: flex; align-items: center; justify-content: center;
      font-size: 32px; font-weight: 700; color: #fff;
    }
    h1 { font-size: 1.5rem; margin: 0 0 8px; }
    p.sub { color: var(--muted); margin: 0 0 8px; line-height: 1.5; }
    .path {
      display: inline-block;
      margin: 4px 0 24px;
      padding: 6px 12px;
      border-radius: 8px;
      background: rgba(56, 189, 248, 0.12);
      color: var(--accent);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.85rem;
      word-break: break-all;
    }
    .stores {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 8px;
    }
    a.btn {
      display: block;
      padding: 14px 18px;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 600;
      transition: transform 0.06s ease, opacity 0.2s ease;
    }
    a.btn:active { transform: translateY(1px); }
    a.play { background: var(--accent-2); color: #052e16; }
    a.app  { background: var(--fg); color: #0f172a; }
    footer { margin-top: 24px; color: var(--muted); font-size: 0.75rem; }
  </style>
</head>
<body>
  <main class="card">
    <div class="logo">A</div>
    <h1>Open in the ATLAS Tech App</h1>
    <p class="sub">This link opens directly in the app. Don’t have it yet? Install it below.</p>
    <span class="path"><%= path %></span>

    <div class="stores">
      <a class="btn play" href="<%= playStoreUrl %>" rel="noopener">Get it on Google Play</a>
      <a class="btn app" href="<%= appStoreUrl %>" rel="noopener">Download on the App Store</a>
    </div>

    <footer>ATLAS SkillTech University &middot; app.atlasskilltech.app</footer>
  </main>
</body>
</html>
