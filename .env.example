# ---------------------------------------------------------------------------
# ATLAS Deep Linking backend — environment configuration
# Copy this file to `.env` and fill in the real values.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
# Port the Node process listens on. Put a reverse proxy (Nginx/Apache) in
# front of this that terminates TLS for deeplink.atlasskilltech.app.
PORT=3000
NODE_ENV=production

# Public host used when building deep-link URLs. No scheme, no trailing slash.
DEEPLINK_HOST=deeplink.atlasskilltech.app
DEEPLINK_SCHEME=https

# Trust the X-Forwarded-* headers from your reverse proxy (1 = enabled).
TRUST_PROXY=1

# --- MySQL (existing ERP database) -----------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=erp_user
DB_PASSWORD=change_me
DB_NAME=erp
DB_CONNECTION_LIMIT=10

# Menu table + column mapping. Adjust to match the existing schema if the ERP
# uses different names. The catch-all / verification files read from here.
DB_MENU_TABLE=menu_master
DB_MENU_ROUTE_COLUMN=route
DB_MENU_LABEL_COLUMN=label
DB_MENU_ID_COLUMN=menu_id
DB_MENU_DEEPLINK_COLUMN=is_deep_linkable

# --- Android (assetlinks.json) ---------------------------------------------
ANDROID_PACKAGE_NAME=com.atlas.tech
# Comma-separated list of release SHA-256 signing fingerprints.
# Get it with:
#   keytool -list -v -keystore android/app/atlas.jks -alias atlas
ANDROID_SHA256_FINGERPRINTS=YOUR_RELEASE_SHA256_FINGERPRINT_HERE

# --- iOS (apple-app-site-association) ---------------------------------------
# Apple Developer Team ID (Apple Developer Portal > Membership).
IOS_TEAM_ID=TEAM_ID
IOS_BUNDLE_ID=com.atlas.tech
# When true, the AASA lists specific menu routes instead of a "/*" wildcard.
IOS_AASA_USE_DYNAMIC_PATHS=false

# --- Store fallback ---------------------------------------------------------
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.atlas.tech
APP_STORE_URL=https://apps.apple.com/app/idYOUR_APP_ID
# Numeric App Store id used by the iOS smart banner (digits only, no "id").
IOS_APP_STORE_ID=YOUR_APP_ID
