# ---------------------------------------------------------------------------
# Nginx reverse proxy for app.atlasskilltech.app -> Node deep-linking backend.
#
# The Node app listens on 127.0.0.1:3000. Nginx terminates TLS for the
# subdomain and forwards everything (including /.well-known/*) to Node WITHOUT
# any redirects, which is required for App Links / Universal Links validation.
# ---------------------------------------------------------------------------

# Redirect plain HTTP to HTTPS (does NOT affect the verification files, which
# are only ever fetched over HTTPS by the OS crawlers).
server {
    listen 80;
    listen [::]:80;
    server_name app.atlasskilltech.app;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.atlasskilltech.app;

    # SSL — use a wildcard cert *.atlasskilltech.app or add this subdomain to
    # your existing certificate.
    ssl_certificate     /etc/letsencrypt/live/atlasskilltech.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/atlasskilltech.app/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Forward the real client info so Node can detect the platform and build
    # correct absolute URLs.
    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;
    }
}
